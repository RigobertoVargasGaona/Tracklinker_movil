<?xml version="1.0" encoding="UTF-8" ?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informacion del usuario"
            android:layout_marginBottom="20dp"
            android:textSize="18sp"
            android:fontFamily="@font/dmsansextrabold"/>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rol :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_rol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
    >
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teléfono :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ciudad :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de creación :"
                android:fontFamily="@font/dmsansextrabold"
        />
        <TextView
                android:id="@+id/info_modal_user_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/dmsansmedium"
        />
    </LinearLayout>
</LinearLayout>