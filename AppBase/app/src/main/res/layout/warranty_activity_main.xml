<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".features.warranties.WarrantiesActivity"
        android:fitsSystemWindows="true"
>
    <include
            layout="@layout/top_section"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/include"/>

    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSerial"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="343dp"
            android:layout_height="56dp"

            android:hint="Serial del Producto"
            app:boxCornerRadiusBottomEnd="20dp"
            app:boxCornerRadiusBottomStart="20dp"
            app:boxCornerRadiusTopEnd="20dp"
            app:boxCornerRadiusTopStart="20dp"
            android:layout_marginTop="70dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:inputType="textCapCharacters"

        />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyWarranties"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="12dp"
            android:background="@color/azul_fondo"
            tools:listitem="@android:layout/simple_list_item_1"
            app:layout_constraintTop_toBottomOf="@+id/receive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintVertical_bias="0.0"/>

    <ImageButton
            android:id="@+id/buttonAgregarGarantia"
            android:layout_width="92dp"
            android:layout_height="78dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Agregar"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/plasicon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.904"
    />
    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/receive"
            android:layout_width="89dp"
            android:layout_height="36dp"
            android:textColor="#666666"
            app:backgroundTint="@null"
            android:background="@drawable/boton_redondeado_gris"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="-1dp"
            android:paddingBottom="0dp"
            android:text="Recibidas"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial"
            app:layout_constraintEnd_toStartOf="@+id/pending"
            android:layout_marginEnd="1dp"
            android:layout_marginTop="5dp"
            app:layout_constraintBottom_toTopOf="@+id/RecyWarranties"
            android:layout_marginBottom="5dp"/>

    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/pending"
            android:layout_width="92dp"
            android:layout_height="36dp"
            android:textColor="#666666"
            app:backgroundTint="@null"
            android:background="@drawable/boton_redondeado_gris"
            android:text="Pendientes"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@+id/receive"
            app:layout_constraintEnd_toStartOf="@+id/finished"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial"
            app:layout_constraintBottom_toTopOf="@+id/RecyWarranties"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp"/>
    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/finished"
            android:layout_width="93dp"
            android:layout_height="36dp"
            android:textColor="#666666"
            app:backgroundTint="@null"
            android:background="@drawable/boton_redondeado_gris"
            android:text="Finalizadas"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial"
            android:layout_marginStart="1dp"
            app:layout_constraintStart_toEndOf="@+id/pending"
            app:layout_constraintEnd_toStartOf="@+id/all"
            android:layout_marginEnd="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toTopOf="@+id/RecyWarranties"/>
    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/all"
            android:layout_width="76dp"
            android:layout_height="35dp"
            android:textColor="#666666"
            app:backgroundTint="@null"
            android:background="@drawable/boton_redondeado_gris"
            android:text="Todas"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial"
            app:layout_constraintStart_toEndOf="@+id/finished"
            app:layout_constraintHorizontal_bias="1.0"
            android:layout_marginStart="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toTopOf="@+id/RecyWarranties"
            app:layout_constraintVertical_bias="0.0"/>

    <include
            layout="@layout/bottom_navbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/bottomNav"/>

</androidx.constraintlayout.widget.ConstraintLayout>