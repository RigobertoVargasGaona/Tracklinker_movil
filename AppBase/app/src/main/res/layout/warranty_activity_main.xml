<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".features.warranties.WarrantiesActivity"
        android:fitsSystemWindows="true"
>


    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSerial"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="343dp"
            android:layout_height="56dp"

            android:hint="Serial del Producto"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/buttonVolver"
    >

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:inputType="textCapCharacters"

        />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyPersonas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="12dp"

            android:background="@color/azul_fondo"
            tools:listitem="@android:layout/simple_list_item_1"
            app:layout_constraintTop_toBottomOf="@+id/button"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintVertical_bias="0.0"/>
    <ImageButton
            android:id="@+id/buttonAgregarGarantia"
            android:layout_width="92dp"
            android:layout_height="78dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Agregar"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/plasicon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.949"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.882"

    />


    <ImageButton
            android:id="@+id/buttonVolver"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon"
            app:tint="@color/black"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recibidas"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial" />

    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendientes"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toEndOf="@+id/button"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial"
            app:layout_constraintBottom_toTopOf="@+id/RecyPersonas"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintEnd_toStartOf="@+id/button3" />

    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finalizadas"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/button4"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial"/>

    <Button
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todas"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutSerial" />

</androidx.constraintlayout.widget.ConstraintLayout>