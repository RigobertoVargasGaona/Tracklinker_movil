<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main" android:layout_width="match_parent"
        android:layout_height="match_parent" tools:context=".ProductosActivity">

    <Button
            android:text="volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/buttonvolver"
            android:onClick="volverpag"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.884"
            app:layout_constraintVertical_bias="0.941"/>

    <EditText
            android:layout_width="350dp"
            android:layout_height="71dp"
            android:inputType="text"
            android:hint="Descripción"
            android:ems="10"
            android:id="@+id/description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/adress" android:layout_marginTop="8dp"
            app:layout_constraintHorizontal_bias="1.0" android:layout_marginEnd="32dp"/>
    <EditText
            android:layout_width="150dp"
            android:layout_height="45dp"
            android:inputType="text"
            android:hint="Ciudad"
            android:ems="10"
            android:id="@+id/city"
            app:layout_constraintStart_toEndOf="@+id/customer"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.607"
            app:layout_constraintTop_toBottomOf="@+id/serial" android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"/>
    <EditText
            android:layout_width="150dp"
            android:layout_height="45dp"
            android:inputType="text"
            android:hint="Teléfono"
            android:ems="10"
            android:id="@+id/phone"
            app:layout_constraintTop_toBottomOf="@+id/customer"
            android:layout_marginTop="8dp" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="32dp" app:layout_constraintEnd_toStartOf="@+id/adress"
            app:layout_constraintHorizontal_bias="0.085"/>
    <EditText
            android:layout_height="45dp"
            android:inputType="text"
            android:hint="Dirección"
            android:ems="10"
            android:id="@+id/adress"
            android:layout_width="150dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@+id/city"
            android:layout_marginTop="8dp" android:layout_marginEnd="36dp"/>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulario crear garantía"
            android:id="@+id/textView2"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="60dp"/>
    <EditText
            android:layout_width="349dp"
            android:layout_height="42dp"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/serial"
            android:hint="Serial"
            tools:ignore="InvalidId"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="28dp" app:layout_constraintTop_toBottomOf="@+id/textView2"
            android:layout_marginTop="40dp"/>
    <EditText
            android:layout_width="150dp"
            android:layout_height="45dp"
            android:inputType="text"
            android:hint="Cliente"
            android:id="@+id/customer"
            android:ems="10"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="32dp" app:layout_constraintTop_toBottomOf="@+id/serial"
            android:layout_marginTop="8dp" app:layout_constraintEnd_toStartOf="@+id/city"
            android:layout_marginEnd="32dp"/>

    <Button
            android:text="Crear garantía"
            android:layout_width="156dp"
            android:layout_height="39dp"
            android:id="@+id/nuevapersona"
            android:onClick="crearGarantia"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.513" app:layout_constraintTop_toBottomOf="@+id/description"
            android:layout_marginTop="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>