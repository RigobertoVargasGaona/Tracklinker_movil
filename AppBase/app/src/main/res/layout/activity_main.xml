<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyPersonas"
            android:layout_width="382dp"
            android:layout_height="841dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@android:layout/simple_list_item_1"
            app:layout_constraintVertical_bias="0.875"
            android:layout_marginBottom="1dp"/>
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAgregar"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="250dp"
            app:layout_constraintBottom_toBottomOf="parent" android:layout_marginBottom="80dp">

        <ImageButton
                android:id="@+id/buttonAgregarGarantia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Agregar"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_input_add"
                app:tint="@android:color/black"/>

    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVolver"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="300dp" android:layout_marginTop="8dp">

        <ImageButton
                android:id="@+id/buttonVolver"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Volver al listado"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon"
                android:onClick="mostrarGarantias"
                app:tint="@android:color/black"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>