<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main" android:layout_width="match_parent"
        android:layout_height="match_parent" tools:context=".MainActivity">

    <ImageView
            android:layout_width="88dp"
            android:layout_height="65dp" app:srcCompat="@android:drawable/alert_light_frame"
            android:id="@+id/imageView"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.049" app:layout_constraintVertical_bias="0.024"/>
    <Button
            android:text="Mostrar Datos"
            android:layout_width="164dp"
            android:layout_height="45dp" android:id="@+id/MostrarApikotlin"
            android:onClick="mostrarGarantias"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="36dp"
            app:layout_constraintVertical_bias="0.96"/>
    <Button
            android:text="Agregar Garantía"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/buttonSegundaActividad"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/MostrarApikotlin" app:layout_constraintHorizontal_bias="0.311"
            app:layout_constraintVertical_bias="0.964"/>
    <LinearLayout
            android:orientation="vertical"
            android:layout_width="317dp"
            android:layout_height="110dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/RecyPersonas"
            app:layout_constraintStart_toStartOf="@+id/RecyPersonas"
            app:layout_constraintEnd_toEndOf="@+id/RecyPersonas">

    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyPersonas"
            android:layout_width="347dp"
            android:layout_height="675dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>